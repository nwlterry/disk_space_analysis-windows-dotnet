<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>SizeTree</RootNamespace>
    <AssemblyName>SizeTree</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Disk space analyzer for Windows Server. Writes the SizeTree report format.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="viewer.html" Condition="Exists('viewer.html')">
      <LogicalName>SizeTree.viewer.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\viewer.html" Condition="!Exists('viewer.html')">
      <LogicalName>SizeTree.viewer.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
